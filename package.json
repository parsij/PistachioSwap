{
  "name": "pistachioswap_lite",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.30.3",
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:local": "node scripts/dev.mjs --local",
    "dev:web": "vite",
    "dev:api": "pnpm --filter @pistachio/api dev",
    "local:bootstrap": "node scripts/local/bootstrap.mjs",
    "local:status": "node scripts/local/status.mjs",
    "local:down": "node scripts/local/down.mjs",
    "pchained:up": "node scripts/local/pchained-cli.mjs up",
    "pchained:down": "node scripts/local/pchained-cli.mjs down",
    "pchained:status": "node scripts/local/pchained-cli.mjs status",
    "prebuild": "pnpm licenses:sync",
    "build": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "pm2:start": "pm2 startOrReload ecosystem.config.cjs --only pistachioswap-api --update-env",
    "pm2:reload": "pm2 startOrReload ecosystem.config.cjs --only pistachioswap-api --update-env",
    "pm2:stop": "pm2 delete pistachioswap-api",
    "pm2:logs": "pm2 logs pistachioswap-api",
    "licenses:audit": "node scripts/audit-third-party-licenses.mjs",
    "licenses:evidence": "node scripts/collect-third-party-license-evidence.mjs",
    "licenses:sync": "node scripts/sync-third-party-license-files.mjs",
    "gas-assist:config:check": "node scripts/gas-assist-local/config-check.mjs",
    "gas-assist:dev": "node scripts/gas-assist-local/dev.mjs",
    "gas-assist:smoke": "node scripts/gas-assist-local/smoke.mjs",
    "audit:private-gas-assist-boundary": "node scripts/audit-private-gas-assist-boundary.mjs",
    "release-tree:audit": "node scripts/audit-public-release-tree.mjs",
    "local-env:report": "bash scripts/collect-local-dev-info.sh",
    "unchained:config:check": "node scripts/unchained-local/config-check.mjs",
    "unchained:print-start-commands": "node scripts/unchained-local/print-start-commands.mjs",
    "test": "vitest run",
    "test:passkey-prf": "node tests/playwright/passkey-prf.integration.mjs",
    "test:wallet-worker": "node tests/playwright/wallet-worker.integration.mjs"
  },
  "dependencies": {
    "@fontsource/ubuntu": "^5.2.8",
    "@metamask/connect-multichain": "1.2.0",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@reown/appkit": "^1.8.22",
    "@reown/appkit-adapter-wagmi": "^1.8.22",
    "@tanstack/react-query": "^5.101.2",
    "debug": "^4.4.3",
    "ethers": "^6.17.0",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "viem": "^2.55.1",
    "wagmi": "^3.7.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tailwindcss/vite": "^4.3.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "oxlint": "^1.71.0",
    "playwright": "^1.61.1",
    "tailwindcss": "^4.3.2",
    "vite": "^8.1.1",
    "vitest": "^4.0.0"
  },
  "pnpm": {
    "_overridesNote": "Bare-name or range selectors so a transitive version bump cannot silently stop an override from matching and reinstall the vulnerable package.",
    "overrides": {
      "@pancakeswap/swap-sdk-core>bn.js": "^5.2.3",
      "axios": "^1.18.0",
      "bigint-buffer": "link:packages/bigint-buffer-safe",
      "esbuild@<=0.24.2": "0.25.12",
      "fast-uri@3": "^3.1.5",
      "fast-uri@4": "^4.1.2",
      "find-my-way": "^9.7.0",
      "nanoid@<3.3.18": "3.3.18",
      "postcss@<=8.5.22": "8.5.23",
      "undici@>=7.0.0 <7.29.0": "7.29.0",
      "uuid@<11.1.1": "11.1.1",
      "viem@2.37.13>ws": "8.21.0"
    }
  }
}
