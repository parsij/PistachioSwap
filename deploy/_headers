# Cloudflare Pages-style origin headers. Copied into dist when this file
# lives in public/; nginx should use deploy/nginx-origin-cache.conf instead.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=604800

/networkIcons/*
  Cache-Control: public, max-age=604800

/favicon.svg
  Cache-Control: public, max-age=604800

/favicon.png
  Cache-Control: public, max-age=604800

/og-image.png
  Cache-Control: public, max-age=604800

/site.webmanifest
  Cache-Control: public, max-age=604800

/
  Cache-Control: public, max-age=0, s-maxage=300, must-revalidate

/index.html
  Cache-Control: public, max-age=0, s-maxage=300, must-revalidate

/landing/*
  Cache-Control: public, max-age=0, s-maxage=300, must-revalidate

/gas-assist/*
  Cache-Control: public, max-age=0, s-maxage=300, must-revalidate

/api/*
  Cache-Control: no-store
