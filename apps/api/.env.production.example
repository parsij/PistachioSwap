# Copy the relevant values into apps/api/.env for production.
# Do not commit the real production file or any secret values.

NODE_ENV=production
HOST=127.0.0.1
PORT=3001

# Exact public frontend origin. Do not use * or include localhost in production.
CORS_ORIGINS=https://YOUR_PRODUCTION_FRONTEND_ORIGIN

# 0 when the API is directly exposed. Otherwise set the exact number of
# trusted reverse-proxy hops that add or forward the client-IP headers.
TRUST_PROXY_HOPS=1

# Per-client public API request limit per minute. Defaults to 300.
API_RATE_LIMIT_MAX=300

# Provider and database secrets remain backend-only.
DATABASE_URL=
ALCHEMY_API_KEY=
MORALIS_API_KEY=
ZEROX_API_KEY=
UNISWAP_API_KEY=
THE_GRAPH_API_KEY=

# Optional Gas Assist integration.
GAS_ASSIST_SERVICE_ENABLED=false
GAS_ASSIST_SERVICE_URL=http://127.0.0.1:3002
GAS_ASSIST_INTERNAL_TOKEN=
GAS_ASSIST_SERVICE_TIMEOUT_MS=30000
GAS_ASSIST_SERVICE_MAX_RESPONSE_BYTES=2097152

# OFAC/sanctions screening. Official list matching is exact-address only.
COMPLIANCE_ENABLED=true
COMPLIANCE_FAIL_CLOSED=true
# Enable only when the origin accepts these headers exclusively from Cloudflare.
COMPLIANCE_TRUST_CLOUDFLARE_GEO=false
COMPLIANCE_BLOCKED_COUNTRY_CODES=CU,IR,KP
# Optional entries formatted COUNTRY:REGION and reviewed by counsel. Do not block all of Ukraine.
COMPLIANCE_BLOCKED_REGION_CODES=
COMPLIANCE_SCREEN_CACHE_MS=300000
OFAC_SDN_URL=https://sanctionslistservice.ofac.treas.gov/api/download/sdn.xml
OFAC_CONSOLIDATED_URL=https://sanctionslistservice.ofac.treas.gov/api/download/consolidated.xml
OFAC_REFRESH_INTERVAL_MS=900000
OFAC_MAX_LIST_AGE_MS=86400000
# Optional third-party sanctions exposure screening. Store auth only in the server env.
TRM_SANCTIONS_ENABLED=false
TRM_SANCTIONS_URL=https://api.trmlabs.com/public/v1/sanctions/screening
TRM_SANCTIONS_AUTHORIZATION=
