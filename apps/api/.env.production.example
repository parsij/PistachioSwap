# Copy the relevant values into apps/api/.env for production.
# Do not commit the real production file or any secret values.

NODE_ENV=production
HOST=127.0.0.1
PORT=3001

# Exact public frontend origin. Do not use * or include localhost in production.
CORS_ORIGINS=https://YOUR_PRODUCTION_FRONTEND_ORIGIN

# 0 when the API is directly exposed. Otherwise set the exact number of
# trusted reverse-proxy hops that add or forward the client-IP headers.
TRUST_PROXY_HOPS=1

# Provider and database secrets remain backend-only.
DATABASE_URL=
ALCHEMY_API_KEY=
MORALIS_API_KEY=
ZEROX_API_KEY=
UNISWAP_API_KEY=
THE_GRAPH_API_KEY=

# Optional Gas Assist integration.
GAS_ASSIST_SERVICE_ENABLED=false
GAS_ASSIST_SERVICE_URL=http://127.0.0.1:3002
GAS_ASSIST_INTERNAL_TOKEN=
GAS_ASSIST_SERVICE_TIMEOUT_MS=30000
GAS_ASSIST_SERVICE_MAX_RESPONSE_BYTES=2097152
